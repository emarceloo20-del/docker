# ===== MySQL =====
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ecommerce_api
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=change_me_user

# ===== Laravel =====
# APP_KEY:   echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# JWT_SECRET: openssl rand -base64 64
JWT_SECRET=
JWT_TTL=60
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
# true = ejecuta php artisan migrate --force al arrancar
RUN_MIGRATIONS=true

# ===== Stripe (https://dashboard.stripe.com/test/apikeys) =====
STRIPE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_CURRENCY=usd

# ===== Swagger (URL que usa el NAVEGADOR para probar la API) =====
L5_SWAGGER_CONST_HOST=http://localhost:8000/api

# ===== Puertos publicados en el host =====
FRONTEND_PORT=3000
BACKEND_PORT=8000
